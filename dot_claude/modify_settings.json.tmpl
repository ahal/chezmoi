#!/bin/bash
# Merge managed top-level keys over the existing settings.json. Unmanaged keys
# (e.g. machine-specific "autoMode" written by Claude Code) are preserved.
read -r -d '' managed <<'JSON'
{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "0"
  },
  "permissions": {
    "allow": [
      "Bash(jj log *)",
      "Bash(jj show *)",
      "Bash(jj diff *)",
      "Bash(jj status)"
    ],
    "deny": [
      "Bash(sops *)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
    {{- if .enable_mozilla }},
    "mozdata@internal-aidev-plugins": true
    {{- end }}
  },
  "extraKnownMarketplaces": {
    "internal-aidev-plugins": {
      "source": {
        "source": "github",
        "repo": "mozilla/internal-aidev-plugins"
      }
    }
  },
  "theme": "dark"
}
JSON

jq -n --argjson managed "$managed" '(try input catch {}) + $managed'
